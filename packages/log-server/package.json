{
  "name": "@lightmill/log-server",
  "version": "5.0.0-beta.3",
  "description": "Server, and middleware to receive, store and export lightmill logs",
  "author": "Quentin Roy <contact@quentinroy.fr>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinRoy/lightmill-js.git",
    "directory": "packages/log-server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "bin": {
    "log-server": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.build.json",
    "prepublish": "pnpm run build",
    "test": "cross-env NODE_ENV=test vitest --typecheck",
    "cli": "node ./src/cli.ts",
    "cli-watch": "node --watch ./src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@types/yargs": "^17.0.33",
    "@vitest/ui": "catalog:",
    "cross-env": "^7.0.3",
    "onchange": "^7.1.0",
    "string-dedent": "^3.0.2",
    "supertest": "^7.3.1",
    "type-fest": "^4.41.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "express": "^5.2.0"
  },
  "dependencies": {
    "@lightmill/log-api": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "csv": "^6.6.4",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "kysely": "^0.29.6",
    "loglevel": "^1.9.2",
    "memorystore": "^1.6.8",
    "remeda": "^2.50.0",
    "yargs": "17.7.2",
    "zod": "^3.25.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.3.0"
  }
}
