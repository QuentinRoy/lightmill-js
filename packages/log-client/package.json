{
  "name": "@lightmill/log-client",
  "version": "5.0.0-beta.2",
  "description": "Client for LightMill's log server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinRoy/lightmill-js.git",
    "directory": "packages/log-client"
  },
  "type": "module",
  "author": "Quentin Roy <contact@quentinroy.fr>",
  "access": "public",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    "import": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "devDependencies": {
    "@types/throttle-debounce": "^5.0.2",
    "@vitest/ui": "catalog:",
    "cross-env": "^10.1.0",
    "msw": "^3.0.2",
    "onchange": "^7.1.0",
    "openapi-typescript": "^7.13.0",
    "type-fest": "^5.10.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@lightmill/log-api": "workspace:*",
    "openapi-fetch": "^0.17.0"
  },
  "scripts": {
    "test": "cross-env NODE_ENV=test vitest",
    "generate-openapi-types": "openapi-typescript node_modules/@lightmill/log-api/dist/openapi.yaml --output src/generated/openapi.ts",
    "build-ts": "tsc -b tsconfig.build.json",
    "build": "pnpm run generate-openapi-types && pnpm run build-ts",
    "prepublish": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "logger",
    "client"
  ],
  "browserslist": [
    "chrome >= 85",
    "edge >= 85",
    "firefox >= 90",
    "safari >= 15",
    "ios_saf >= 15"
  ]
}
