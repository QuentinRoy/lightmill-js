{
  "name": "@lightmill/convert-touchstone",
  "version": "4.0.0-beta.0",
  "type": "module",
  "description": "Converts touchstone XML exports to lightmill format.",
  "engines": {
    "node": ">=24.12.0"
  },
  "exports": {
    "import": {
      "types": "./dist/convert-touchstone.d.ts",
      "default": "./dist/convert-touchstone.js"
    }
  },
  "bin": {
    "lightmill-convert-touchstone": "./bin/cli.mjs"
  },
  "author": "Quentin Roy <contact@quentinroy.fr>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinRoy/lightmill-js.git",
    "directory": "packages/convert-touchstone"
  },
  "access": "public",
  "dependencies": {
    "sax": "~1.5.0",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "@types/sax": "^1.2.7",
    "cross-env": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "test": "cross-env NODE_ENV=test vitest",
    "build": "tsc -b tsconfig.build.json",
    "prepublish": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "bin"
  ]
}
